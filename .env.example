# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG BACKEND & FRONTEND (KHẢO THÍ SỐ — PRODUCTION)
# ============================================================================

# 1. Khóa bí mật ký phiên làm việc trên Server (Bắt buộc đặt chuỗi ngẫu nhiên >= 32 ký tự ở Production)
SESSION_SIGNING_SECRET="CHANGE_ME_TO_A_32_BYTE_RANDOM_HEX_SECRET"

# 2. Mã bí mật khởi tạo Quản trị viên đầu tiên dùng một lần (One-Time Admin Bootstrap Secret)
# Dùng một lần duy nhất tại màn hình /admin/setup để tạo Quản trị viên đầu tiên.
# Sau khi Quản trị viên đầu tiên được khởi tạo, quy trình bootstrap tự động khóa vĩnh viễn.
ADMIN_BOOTSTRAP_SECRET="SET_YOUR_ONE_TIME_BOOTSTRAP_SECRET_HERE"

# 3. Email chủ sở hữu được phép nhận quyền Admin khi thực hiện Bootstrap lần đầu (Tùy chọn)
ADMIN_OWNER_EMAIL=""

# 4. GEMINI_API_KEY: Khóa API Gemini trên Backend để bóc tách câu hỏi từ PDF/Ảnh bằng AI (Không bao giờ lộ xuống Frontend)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 5. Danh sách Domain Frontend được phép gọi API (CORS) — phân tách bằng dấu phẩy
# Ví dụ: https://www.taodethi.xyz,https://admin.taodethi.xyz,https://student-app.pages.dev,https://admin-app.pages.dev
ALLOWED_ORIGINS="http://localhost:3000"

# 6. Biến môi trường khi build tách biệt 2 Frontend (Cloudflare Pages)
# Đặt VITE_APP_TARGET="student" cho dự án Cloudflare Pages của Học sinh
# Đặt VITE_APP_TARGET="admin" cho dự án Cloudflare Pages của Quản trị viên
VITE_APP_TARGET=""

# URL của Backend API dùng chung khi triển khai 2 Frontend trên 2 domain riêng (Để trống nếu dùng chung reverse-proxy)
VITE_API_BASE_URL=""

# URL của từng ứng dụng để điều hướng chéo khi cần
VITE_STUDENT_APP_URL=""
VITE_ADMIN_APP_URL=""

# 7. Cấu hình kết nối Supabase (Tùy chọn khi chuyển sang PostgreSQL + Supabase Auth/Storage)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
